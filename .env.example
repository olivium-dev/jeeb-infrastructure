# ──────────────────────────────────────────────
# jeeb-infrastructure — environment variables
# Copy to .env and fill in real values.
# NEVER commit .env — only .env.example is tracked.
#
# Per-environment files live alongside this one on each host:
#   /opt/jeeb/.env             — production
#   /opt/jeeb-staging/.env     — staging
#   ./.env                     — local dev
# ──────────────────────────────────────────────

# ── Postgres ──────────────────────────────────
POSTGRES_USER=jeeb
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# ── JWT ───────────────────────────────────────
# 32+ random bytes (e.g. `openssl rand -base64 48`)
JWT_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_ISSUER=jeeb-gateway

# ── Container registry ────────────────────────
REGISTRY=ghcr.io/olivium-dev
IMAGE_TAG=latest

# ── Deployment target (used only by deploy/*.sh) ──
DEPLOY_HOST=
DEPLOY_USER=

# ── Public domains (Traefik TLS termination) ──
# Required when running with docker-compose.staging.yml or production.yml
GATEWAY_DOMAIN=api.staging.jeeb.app
MINIO_API_DOMAIN=s3.staging.jeeb.app
MINIO_CONSOLE_DOMAIN=minio.staging.jeeb.app

# ── Let's Encrypt (Traefik) ───────────────────
# Production: leave ACME_CA_SERVER unset (defaults to prod issuer).
# Staging:    set to staging issuer to avoid hitting prod rate limits.
ACME_EMAIL=ops@jeeb.app
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# ── Firebase ──────────────────────────────────
# The service-account JSON is mounted into the gateway container.
# Put the file on the host at FIREBASE_SA_HOST_PATH; do NOT bake it into the image.
FIREBASE_PROJECT_ID=jeeb-staging
FIREBASE_SA_HOST_PATH=/etc/jeeb/firebase-sa.json

# ── Shorebird OTA (Flutter Code Push) ─────────
# Used only by scripts/shorebird-patch.sh and the mobile-ota-shorebird
# GitHub Actions workflow. Mint with `shorebird login:ci`. 90-day rotation.
# See deploy/mobile-ota-runbook.md §3.
SHOREBIRD_TOKEN=

# ── Object storage (S3 / MinIO) ───────────────
# STORAGE_PROVIDER=minio  → use the in-cluster MinIO service
# STORAGE_PROVIDER=s3     → use AWS S3 / DO Spaces / R2 (set S3_ENDPOINT accordingly)
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=jeeb-staging
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# ──────────────────────────────────────────────
# Observability (Prometheus + Grafana + OTel)
# Enabled by `--profile monitoring` on docker compose.
# ──────────────────────────────────────────────

# Tags every metric / span / log with the environment name.
ENVIRONMENT=development

# OTLP endpoint that backend services export to. Inside the compose network
# this is the collector; in staging/prod set to the managed collector URL.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Grafana admin bootstrap (change before exposing on staging).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ──────────────────────────────────────────────
# Sentry (backend exceptions + trace forwarding)
# Leave empty in dev to disable capture.
# ──────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# OTLP→Sentry forwarder. Format:
#   https://o<org>.ingest.sentry.io:443/api/<project-id>/otlp/v1/traces
SENTRY_OTLP_ENDPOINT=
SENTRY_KEY=

# ──────────────────────────────────────────────
# Mobile (Flutter) — Crashlytics
# Crashlytics is configured via the google-services.json /
# GoogleService-Info.plist files in jeeb-mobile, not env vars.
# These flags only toggle capture for non-release builds.
# ──────────────────────────────────────────────
CRASHLYTICS_DEBUG_CAPTURE=false
