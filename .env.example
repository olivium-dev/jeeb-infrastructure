# ──────────────────────────────────────────────
# jeeb-infrastructure — environment variables
# Copy to .env and fill in real values
# NEVER commit .env — only .env.example is tracked
# ──────────────────────────────────────────────

# Postgres
POSTGRES_USER=jeeb
POSTGRES_PASSWORD=changeme

# JWT (generate a strong random key for production)
JWT_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_ISSUER=jeeb-gateway

# Container registry (staging/production)
REGISTRY=ghcr.io/olivium-dev
IMAGE_TAG=latest

# Deployment target
DEPLOY_HOST=
DEPLOY_USER=

# ──────────────────────────────────────────────
# Observability (Prometheus + Grafana + OTel)
# Enabled by `--profile monitoring` on docker compose.
# ──────────────────────────────────────────────

# Tags every metric / span / log with the environment name.
ENVIRONMENT=development

# OTLP endpoint that backend services export to. Inside the compose network
# this is the collector; in staging/prod set to the managed collector URL.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Grafana admin bootstrap (change before exposing on staging).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ──────────────────────────────────────────────
# Sentry (backend exceptions + trace forwarding)
# Leave empty in dev to disable capture.
# ──────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# OTLP→Sentry forwarder. Format:
#   https://o<org>.ingest.sentry.io:443/api/<project-id>/otlp/v1/traces
SENTRY_OTLP_ENDPOINT=
SENTRY_KEY=

# ──────────────────────────────────────────────
# Mobile (Flutter) — Crashlytics
# Crashlytics is configured via the google-services.json /
# GoogleService-Info.plist files in jeeb-mobile, not env vars.
# These flags only toggle capture for non-release builds.
# ──────────────────────────────────────────────
CRASHLYTICS_DEBUG_CAPTURE=false
