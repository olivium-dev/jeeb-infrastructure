# ──────────────────────────────────────────────
# jeeb-infrastructure — observability env vars
# Append these to your .env when running with the monitoring profile.
# ──────────────────────────────────────────────

# Tags every metric / span / log with the environment name.
ENVIRONMENT=development

# OTLP endpoint that backend services export to. Inside the compose network
# this is the collector; in staging/prod set to the managed collector URL.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Grafana admin bootstrap (change before exposing on staging).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Sentry — leave SENTRY_DSN empty in dev to disable capture.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# OTLP→Sentry forwarder. Format:
#   https://o<org>.ingest.sentry.io:443/api/<project-id>/otlp/v1/traces
SENTRY_OTLP_ENDPOINT=
SENTRY_KEY=

# Mobile (Flutter) — Crashlytics is configured via the
# google-services.json / GoogleService-Info.plist files in jeeb-mobile,
# not env vars. This flag only toggles capture for non-release builds.
CRASHLYTICS_DEBUG_CAPTURE=false
