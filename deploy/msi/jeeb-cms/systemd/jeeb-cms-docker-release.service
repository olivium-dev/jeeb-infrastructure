[Unit]
Description=Validate the active Jeeb CMS Docker-hosted release
Documentation=file:/home/ec2-user/jeeb-cms-hosting/README.md
After=local-fs.target
Before=jeeb-cms-nginx.service

[Service]
Type=oneshot
EnvironmentFile=/home/ec2-user/.config/jeeb-cms/nginx.env
ExecStart=/home/ec2-user/jeeb-cms-hosting/scripts/verify-current.sh
RemainAfterExit=yes
User=ec2-user
Group=ec2-user

[Install]
WantedBy=multi-user.target
